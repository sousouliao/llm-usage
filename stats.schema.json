{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Mournerliao/llm-usage/main/stats.schema.json",
  "title": "LLM Usage Stats",
  "description": "LLM 用量的数据契约（单一事实源）。llm_usage.fold 产出，render.py 与 UsageWidget 共同消费 weeks[].view。字段名以本文件为准。",
  "type": "object",
  "required": ["schema_version", "timezone", "latest_date", "weeks", "sources", "daily", "year", "generated_at", "updated_display"],
  "properties": {
    "schema_version": {
      "const": 4,
      "description": "契约版本。消费方应校验它，避免在字段语义变更后静默渲染错误数据。v1 用 input_tokens/output_tokens；v2 改为 unit + amount + machine；v3 去掉 unit 与 machine，改用具名 token 字段并加入 cost_cents 与周维度；v4 把 WeekView 物化进 weeks[].view，渲染器不再各自计算。generated_at / updated_display 是页脚刷新时刻，不参与周次计算，不升版本。"
    },
    "timezone": {
      "type": "string",
      "description": "所有日期与周次的计算时区，如 Asia/Shanghai。取自 config/aggregate.yaml。"
    },
    "latest_date": {
      "type": ["string", "null"],
      "description": "最近一天有用量的日期，格式 YYYY-MM-DD；无数据时 null。周次窗口由它推出，而不是由运行时的当天推出，这样产物完全由原始数据决定。"
    },
    "generated_at": {
      "type": "string",
      "description": "产物写出时刻，ISO 8601，配置时区（如 2026-08-18T17:20:00+08:00）。这是唯一一个由运行时钟决定的字段：用来回答「这张卡片还新不新」，不参与周次窗口。同一份 raw 在不同时刻重跑，只有这一项和 updated_display 会变。"
    },
    "updated_display": {
      "type": "string",
      "description": "generated_at 的展示文案，如 Updated Aug 18, 17:20。两端渲染器只读这一项，不自己格式化。"
    },
    "weeks": {
      "type": "array",
      "description": "可展示的 ISO 周，新的在前，共 4 个（本周加过去三周）。每个元素带已经算好的 view。README 的 SVG 只渲染第一个 view；博客组件用 weeks 做切换。",
      "items": {
        "type": "object",
        "required": ["week", "start", "end", "view"],
        "properties": {
          "week": {
            "type": "string",
            "pattern": "^\\d{4}-W\\d{2}$",
            "description": "ISO 周编号，如 2026-W34。"
          },
          "start": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "该周周一。"
          },
          "end": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "该周周日。"
          },
          "view": {
            "$ref": "#/$defs/weekView"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": { "type": "string" },
      "description": "数据中出现过的所有源，如 cursor / codex / antigravity。"
    },
    "subscription_sources": {
      "type": "array",
      "items": { "type": "string" },
      "description": "订阅制源。raw 没有官方成本；fold 按 API 牌价补折算值，对不上牌价的模型金额列仍显示 Subscription。取自 config/aggregate.yaml。"
    },
    "daily": {
      "type": "array",
      "description": "按 (date, source, model) 聚合后的日记录，只保留 weeks 覆盖的窗口（≤28 天）。完整历史在 data/raw 里，随时可以重新切窗口。",
      "items": {
        "type": "object",
        "required": ["date", "source", "model", "requests"],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "按 timezone 计算的日期。"
          },
          "source": {
            "type": "string",
            "description": "源名，如 cursor / antigravity / deepseek。"
          },
          "model": {
            "type": "string",
            "description": "归一后的模型名（别名表见 config/aggregate.yaml）。"
          },
          "requests": {
            "type": "integer",
            "minimum": 0,
            "description": "调用次数。任何源都应能给出，所以它是必填字段。"
          },
          "tokens_in": {
            "type": "integer",
            "minimum": 0,
            "description": "输入 token。字段缺失表示该源不报此口径，与「报了但是零」不是一回事。"
          },
          "tokens_out": {
            "type": "integer",
            "minimum": 0,
            "description": "输出 token。缺失语义同 tokens_in。"
          },
          "cache_write": {
            "type": "integer",
            "minimum": 0,
            "description": "缓存写入 token。缺失语义同 tokens_in。"
          },
          "cache_read": {
            "type": "integer",
            "minimum": 0,
            "description": "缓存读取 token。在 agent 式使用下通常占总量九成以上，所以绝不与其他三类合并成一个总数。"
          },
          "cost_cents": {
            "type": "number",
            "minimum": 0,
            "description": "token 按各模型单价折算出的成本，单位为分。刻意是浮点：单次调用常在一分以下，取整会让求和系统性偏小。这不是账单金额——不含套餐、折扣与平台抽成。"
          }
        }
      }
    },
    "year": {
      "type": ["object", "null"],
      "description": "当年汇总。目前不展示，先存着，等数据攒够一年再用。",
      "required": ["year", "start", "end", "days_active", "months", "models"],
      "properties": {
        "year": { "type": "string", "pattern": "^\\d{4}$" },
        "start": { "type": ["string", "null"], "description": "当年第一天有用量的日期。" },
        "end": { "type": ["string", "null"], "description": "当年最后一天有用量的日期。" },
        "days_active": {
          "type": "integer",
          "minimum": 0,
          "description": "当年有用量的天数（不是日历天数）。"
        },
        "requests": { "type": "integer", "minimum": 0 },
        "tokens_in": { "type": ["integer", "null"], "minimum": 0 },
        "tokens_out": { "type": ["integer", "null"], "minimum": 0 },
        "cache_write": { "type": ["integer", "null"], "minimum": 0 },
        "cache_read": { "type": ["integer", "null"], "minimum": 0 },
        "tokens_total": { "type": ["integer", "null"], "minimum": 0 },
        "cost_cents": { "type": ["number", "null"], "minimum": 0 },
        "months": {
          "type": "array",
          "description": "按月汇总，时间升序。",
          "items": {
            "type": "object",
            "required": ["month", "requests"],
            "properties": {
              "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
              "requests": { "type": "integer", "minimum": 0 },
              "tokens_total": { "type": ["integer", "null"], "minimum": 0 },
              "cost_cents": { "type": ["number", "null"], "minimum": 0 }
            }
          }
        },
        "models": {
          "type": "array",
          "description": "按模型汇总，token 降序。",
          "items": {
            "type": "object",
            "required": ["model", "requests"],
            "properties": {
              "model": { "type": "string" },
              "requests": { "type": "integer", "minimum": 0 },
              "tokens_total": { "type": ["integer", "null"], "minimum": 0 },
              "cost_cents": { "type": ["number", "null"], "minimum": 0 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "weekView": {
      "type": "object",
      "description": "某一周已经算好的展示视图：排序、占比、格式化字符串。由 llm_usage.view 在 fold 时写入。",
      "required": ["week", "start", "end", "range_display", "basis", "requests",
                   "tokens_display", "cost_display", "requests_display",
                   "breakdown", "models", "days"],
      "properties": {
        "week": { "type": ["string", "null"] },
        "start": { "type": ["string", "null"] },
        "end": { "type": ["string", "null"] },
        "range_display": { "type": "string" },
        "basis": { "type": "string", "enum": ["cost", "tokens", "requests"] },
        "requests": { "type": "integer", "minimum": 0 },
        "tokens_total": { "type": ["integer", "null"] },
        "cost_cents": { "type": ["number", "null"] },
        "tokens_display": { "type": "string" },
        "cost_display": { "type": "string" },
        "requests_display": { "type": "string" },
        "breakdown": { "type": "array" },
        "models": { "type": "array" },
        "days": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["date", "weekday", "requests", "tokens_display"],
            "properties": {
              "date": { "type": "string" },
              "weekday": { "type": "string" },
              "requests": { "type": "integer" },
              "tokens_total": { "type": ["integer", "null"] },
              "cost_cents": { "type": ["number", "null"] },
              "tokens_display": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
